# Cloud Build / Cloud Run source-deploy ignore file for the Lucky5 v8 monorepo.
#
# This is a large multi-tool monorepo (decompiled game archives, AI tool scratch
# folders, node_modules, screenshots, etc.). Only the .NET server under `server/`
# and the root build files are needed to build the Lucky5.Api container image.
# Everything else is excluded to keep `gcloud builds submit` / `gcloud run deploy
# --source` uploads small and fast.
#
# Pattern semantics match .gitignore: a bare `/*` at the root excludes every
# top-level entry, then `!`-prefixed rules re-include exactly what the build needs.

/*

!/server
!/server/**
!/cloudbuild.yaml
!/.gcloudignore

# Re-exclude build artifacts and local dev state that may exist under server/.
server/**/bin/
server/**/obj/
server/**/node_modules/
server/**/.vscode/
server/**/.vs/

# Explicitly exclude all AI agent state directories (defense-in-depth even after /* above).
.history/
.vexp/
.cursor/
.kiro/
.windsurf/
.zed/
.contextstream/
.antigravity/
.agentsroom/
.goals/
.brain/
.openclaw/
.cagent/
.agent-runtime/
.codex/
.opencode/
.agent-jobs/
.comp/
.claude/
.gemini/
.continue/
.trae/
.memory/
.github/copilot/
.github/skills/
.github/instructions/
playpoker/
ai9/
Ai9/
goldenpoker/
analysis/
mediafiles/
ai999_frames/
pagesource_output/
db-context-enrichment/
genai-for-developers/
azd-ai-starter-basic/
guestbook-*/
genai-for-developers/
build/
attached_assets/
tmp/
.local/
plans/
artifacts/